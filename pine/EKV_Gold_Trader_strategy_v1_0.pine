//@version=6
// @description NY SMC research strategy for TradingView Strategy Tester only.
// It is a conservative model of confirmed-bar signals, not an MT5 fill simulator.
strategy("EKV Gold Trader Strategy v1.0 — NY SMC Backtest", overlay = true, pyramiding = 0, initial_capital = 100000, currency = currency.USD, commission_type = strategy.commission.percent, commission_value = 0.01, slippage = 2, margin_long = 1, margin_short = 1, process_orders_on_close = false, calc_on_order_fills = false, max_labels_count = 100, max_lines_count = 100)

const string G_TEST = "01 — Test environment"
const string G_BIAS = "02 — HTF bias"
const string G_SETUP = "03 — NY SMC setup"
const string G_RISK = "04 — Risk model"
const string G_NEWS = "05 — Manual news blackout"

bool enforceM5 = input.bool(true, "Allow entries only on M5", group = G_TEST)
bool enforceXauUsd = input.bool(true, "Allow entries only on XAUUSD", group = G_TEST)
bool showDiagnostics = input.bool(false, "Show backtest diagnostics", group = G_TEST, tooltip = "Enable only while debugging the setup funnel.")
int testFrom = input.time(timestamp("01 Jan 2023 00:00 +0000"), "Test from", group = G_TEST)
int testTo = input.time(timestamp("01 Jan 2030 00:00 +0000"), "Test to", group = G_TEST)
int maxTradesPerDay = input.int(2, "Maximum filled trades per NY day", minval = 1, maxval = 5, group = G_TEST)
string nyTimezone = input.string("America/New_York", "Session timezone", group = G_TEST)
string nySession = input.session("0930-1200", "NY Open entry window", group = G_TEST)

string h1Tf = input.timeframe("60", "H1 timeframe", group = G_BIAS)
string h4Tf = input.timeframe("240", "H4 timeframe", group = G_BIAS)
int fastLen = input.int(50, "Fast EMA", minval = 2, group = G_BIAS)
int slowLen = input.int(200, "Slow EMA", minval = 10, group = G_BIAS)
bool useSlope = input.bool(true, "Require fast EMA slope", group = G_BIAS)
string signalProfile = input.string("Session CHoCH", "Backtest profile", options = ["Session CHoCH", "Production", "Balanced experimental"], group = G_BIAS, tooltip = "Session CHoCH follows the first confirmed structure break after 09:30 NY without an EMA direction gate.")

int swingLen = input.int(3, "Confirmed pivot length", minval = 2, maxval = 15, group = G_SETUP)
int maxChochToFvg = input.int(8, "Max bars: CHoCH → FVG", minval = 1, maxval = 30, group = G_SETUP)
int pendingExpiry = input.int(20, "FVG limit expiry (bars)", minval = 1, maxval = 50, group = G_SETUP)
int atrLen = input.int(14, "ATR length", minval = 2, group = G_SETUP)
float displacementAtr = input.float(0.3, "Minimum CHoCH body (ATR)", minval = 0.0, step = 0.05, group = G_SETUP)
float minFvgAtr = input.float(0.05, "Minimum FVG size (ATR)", minval = 0.0, step = 0.01, group = G_SETUP)
float fibZoneStart = input.float(0.50, "Fib zone start", minval = 0.0, maxval = 1.0, step = 0.001, group = G_SETUP)
float fibZoneEnd = input.float(0.618, "Fib golden level", minval = 0.0, maxval = 1.0, step = 0.001, group = G_SETUP)
float slBufferAtr = input.float(0.1, "SL buffer behind FVG candle (ATR)", minval = 0.0, step = 0.05, group = G_SETUP)
float minStopAtr = input.float(0.1, "Minimum stop distance (ATR)", minval = 0.1, step = 0.05, group = G_SETUP, tooltip = "Wide research default. Tighten this range only after reviewing the risk-reject counter.")
float maxStopAtr = input.float(10.0, "Maximum stop distance (ATR)", minval = 0.5, step = 0.1, group = G_SETUP, tooltip = "Wide research default. Tighten this range only after reviewing the risk-reject counter.")

string sizingMode = input.string("Risk % (dynamic)", "Position sizing mode", options = ["Risk % (dynamic)", "Fixed lots"], group = G_RISK)
float riskPercent = input.float(0.5, "Risk per trade (% equity)", minval = 0.05, maxval = 5.0, step = 0.05, group = G_RISK, tooltip = "Dynamic lots = equity × risk % / (SL distance × contract size).")
float fixedLots = input.float(0.10, "Fixed lots", minval = 0.01, step = 0.01, group = G_RISK)
float lotMultiplier = input.float(1.0, "Lot multiplier", minval = 0.1, maxval = 10.0, step = 0.1, group = G_RISK, tooltip = "Multiplies the dynamic or fixed base lot size.")
float maxLots = input.float(10.0, "Maximum lots", minval = 0.01, maxval = 100.0, step = 0.01, group = G_RISK)
float rewardRisk = input.float(4.0, "Take profit (R)", minval = 1.0, maxval = 10.0, step = 0.25, group = G_RISK)
float beOffset = input.float(0.1, "BE cost offset (USD/oz)", minval = 0.0, step = 0.01, group = G_RISK)
float contractSize = input.float(100.0, "Contract size: oz per lot", minval = 1.0, group = G_RISK)
float minLot = input.float(0.01, "Minimum lot", minval = 0.001, step = 0.001, group = G_RISK)
float lotStep = input.float(0.01, "Lot step", minval = 0.001, step = 0.001, group = G_RISK)

bool useNews = input.bool(false, "Enable manual news blackout", group = G_NEWS)
int newsBeforeMin = input.int(30, "Minutes blocked before event", minval = 0, maxval = 180, group = G_NEWS)
int newsAfterMin = input.int(30, "Minutes blocked after event", minval = 0, maxval = 180, group = G_NEWS)
bool news1On = input.bool(false, "Use event 1", inline = "N1", group = G_NEWS)
int news1 = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Event 1", inline = "N1", group = G_NEWS)
bool news2On = input.bool(false, "Use event 2", inline = "N2", group = G_NEWS)
int news2 = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Event 2", inline = "N2", group = G_NEWS)

f_roundDown(float value, float step) =>
    step > 0 ? math.floor(value / step + 1e-9) * step : value

f_inNews(bool enabled, int eventTime, int beforeMs, int afterMs) =>
    enabled and time_close >= eventTime - beforeMs and time <= eventTime + afterMs

float h1Close = request.security(syminfo.tickerid, h1Tf, close[1], lookahead = barmerge.lookahead_on)
float h1Fast = request.security(syminfo.tickerid, h1Tf, ta.ema(close, fastLen)[1], lookahead = barmerge.lookahead_on)
float h1FastPrev = request.security(syminfo.tickerid, h1Tf, ta.ema(close, fastLen)[2], lookahead = barmerge.lookahead_on)
float h1Slow = request.security(syminfo.tickerid, h1Tf, ta.ema(close, slowLen)[1], lookahead = barmerge.lookahead_on)
float h4Close = request.security(syminfo.tickerid, h4Tf, close[1], lookahead = barmerge.lookahead_on)
float h4Fast = request.security(syminfo.tickerid, h4Tf, ta.ema(close, fastLen)[1], lookahead = barmerge.lookahead_on)
float h4FastPrev = request.security(syminfo.tickerid, h4Tf, ta.ema(close, fastLen)[2], lookahead = barmerge.lookahead_on)
float h4Slow = request.security(syminfo.tickerid, h4Tf, ta.ema(close, slowLen)[1], lookahead = barmerge.lookahead_on)
bool h1Bull = h1Close > h1Slow and h1Fast > h1Slow and (not useSlope or h1Fast > h1FastPrev)
bool h1Bear = h1Close < h1Slow and h1Fast < h1Slow and (not useSlope or h1Fast < h1FastPrev)
bool h4Bull = h4Close > h4Slow and h4Fast > h4Slow and (not useSlope or h4Fast > h4FastPrev)
bool h4Bear = h4Close < h4Slow and h4Fast < h4Slow and (not useSlope or h4Fast < h4FastPrev)
bool biasBull = h1Bull and h4Bull
bool biasBear = h1Bear and h4Bear
bool productionProfile = signalProfile == "Production"
bool balancedProfile = signalProfile == "Balanced experimental"
bool sessionChochProfile = signalProfile == "Session CHoCH"
bool biasGateBull = sessionChochProfile or (productionProfile ? biasBull : (h1Bull or h4Bull) and not (h1Bear or h4Bear))
bool biasGateBear = sessionChochProfile or (productionProfile ? biasBear : (h1Bear or h4Bear) and not (h1Bull or h4Bull))

float atr = ta.atr(atrLen)
bool timeframeOk = timeframe.isminutes and timeframe.multiplier == 5
bool symbolOk = str.contains(syminfo.ticker, "XAUUSD")
bool htfOk = timeframe.in_seconds(h1Tf) > timeframe.in_seconds() and timeframe.in_seconds(h4Tf) > timeframe.in_seconds(h1Tf)
bool configOk = fastLen < slowLen and fibZoneStart < fibZoneEnd and minStopAtr <= maxStopAtr and minLot > 0 and lotStep > 0 and maxLots >= minLot
bool platformOk = (not enforceM5 or timeframeOk) and (not enforceXauUsd or symbolOk) and htfOk and configOk
int endHour = int(str.tonumber(str.substring(nySession, 5, 7)))
int endMinute = int(str.tonumber(str.substring(nySession, 7, 9)))
int endMinuteOfDay = endHour * 60 + endMinute
int closeMinuteOfDay = hour(time_close, nyTimezone) * 60 + minute(time_close, nyTimezone)
bool inNySession = not na(time(timeframe.period, nySession, nyTimezone))
bool newPlanWindowOpen = inNySession and closeMinuteOfDay < endMinuteOfDay
int beforeMs = newsBeforeMin * 60000
int afterMs = newsAfterMin * 60000
bool newsBlackout = useNews and (f_inNews(news1On, news1, beforeMs, afterMs) or f_inNews(news2On, news2, beforeMs, afterMs))
bool dateOk = time >= testFrom and time <= testTo

int nyDayKey = year(time, nyTimezone) * 10000 + month(time, nyTimezone) * 100 + dayofmonth(time, nyTimezone)
var int lastNyDayKey = na
var int tradesToday = 0
if na(lastNyDayKey) or nyDayKey != lastNyDayKey
    lastNyDayKey := nyDayKey
    tradesToday := 0

float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
var bool lastSwingHighCrossed = false
var bool lastSwingLowCrossed = false
var int structureBias = 0
if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - swingLen
    lastSwingHighCrossed := false
if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - swingLen
    lastSwingLowCrossed := false

bool bullStructureBreakRaw = not na(lastSwingHigh) and not lastSwingHighCrossed and close > lastSwingHigh and bar_index > lastSwingHighBar and barstate.isconfirmed
bool bearStructureBreakRaw = not na(lastSwingLow) and not lastSwingLowCrossed and close < lastSwingLow and bar_index > lastSwingLowBar and barstate.isconfirmed
bool bullStructureBreak = bullStructureBreakRaw and not bearStructureBreakRaw
bool bearStructureBreak = bearStructureBreakRaw and not bullStructureBreakRaw
bool bullChochEvent = bullStructureBreak and structureBias == -1
bool bearChochEvent = bearStructureBreak and structureBias == 1
if bullStructureBreak
    lastSwingHighCrossed := true
    structureBias := 1
if bearStructureBreak
    lastSwingLowCrossed := true
    structureBias := -1

var int stage = 0  // 0 wait CHoCH, 1 wait aligned FVG, 2 pending, 3 live
var int direction = 0
var int chochBar = na
var int fvgBar = na
var float impulseOrigin = na
var float impulseExtreme = na
var float beConfirmLevel = na
var float plannedEntry = na
var float plannedSL = na
var float plannedTP = na
var float plannedLots = na
var float plannedQty = na
var bool beMoved = false
var bool positionWasOpen = false
var bool sessionChochFound = false
var int rawChochCount = 0
var int qualifiedChochCount = 0
var int fvgCount = 0
var int alignedFvgCount = 0
var int riskRejectCount = 0
var int orderCount = 0

bool sessionStart = inNySession and not inNySession[1]
if sessionStart
    sessionChochFound := false
    if strategy.position_size == 0
        strategy.cancel("NY-CHOCH-L")
        strategy.cancel("NY-CHOCH-S")
        stage := 0
        direction := 0
        chochBar := na
        fvgBar := na
        impulseOrigin := na
        impulseExtreme := na

float body = math.abs(close - open)
bool displacementOk = displacementAtr <= 0 or body >= atr * displacementAtr
bool canDetectChoch = stage == 0 and not sessionChochFound and strategy.position_size == 0 and platformOk and dateOk and newPlanWindowOpen and not newsBlackout and tradesToday < maxTradesPerDay
bool rawBullChoch = canDetectChoch and bullChochEvent and displacementOk
bool rawBearChoch = canDetectChoch and bearChochEvent and displacementOk
bool bullChoch = rawBullChoch and not rawBearChoch and biasGateBull
bool bearChoch = rawBearChoch and not rawBullChoch and biasGateBear
if rawBullChoch or rawBearChoch
    rawChochCount += 1
if bullChoch or bearChoch
    qualifiedChochCount += 1
    sessionChochFound := true
    stage := 1
    direction := bullChoch ? 1 : -1
    chochBar := bar_index
    impulseOrigin := bullChoch ? lastSwingLow : lastSwingHigh
    impulseExtreme := bullChoch ? high : low

if stage == 1 and direction == 1
    impulseExtreme := math.max(impulseExtreme, high)
if stage == 1 and direction == -1
    impulseExtreme := math.min(impulseExtreme, low)

float impulseRange = not na(impulseOrigin) and not na(impulseExtreme) ? math.abs(impulseExtreme - impulseOrigin) : na
float fib50 = direction == 1 ? impulseExtreme - impulseRange * fibZoneStart : impulseExtreme + impulseRange * fibZoneStart
float fib618 = direction == 1 ? impulseExtreme - impulseRange * fibZoneEnd : impulseExtreme + impulseRange * fibZoneEnd
float fibLower = math.min(fib50, fib618)
float fibUpper = math.max(fib50, fib618)
bool bullFvgDisplacement = close[1] > open[1] and close[1] > high[2] and (displacementAtr <= 0 or math.abs(close[1] - open[1]) >= atr[1] * displacementAtr)
bool bearFvgDisplacement = close[1] < open[1] and close[1] < low[2] and (displacementAtr <= 0 or math.abs(close[1] - open[1]) >= atr[1] * displacementAtr)
bool bullFvgRaw = stage == 1 and direction == 1 and bar_index > chochBar and low > high[2] and low - high[2] >= atr * minFvgAtr and bullFvgDisplacement and barstate.isconfirmed
bool bearFvgRaw = stage == 1 and direction == -1 and bar_index > chochBar and high < low[2] and low[2] - high >= atr * minFvgAtr and bearFvgDisplacement and barstate.isconfirmed
float candidateFvgLow = bullFvgRaw ? high[2] : bearFvgRaw ? high : na
float candidateFvgHigh = bullFvgRaw ? low : bearFvgRaw ? low[2] : na
float candidateMid = not na(candidateFvgLow) ? (candidateFvgLow + candidateFvgHigh) / 2.0 : na
bool fibAligned = not na(candidateMid) and impulseRange > 0 and candidateMid >= fibLower and candidateMid <= fibUpper
bool fvgSignal = newPlanWindowOpen and not newsBlackout and (bullFvgRaw or bearFvgRaw) and fibAligned
if bullFvgRaw or bearFvgRaw
    fvgCount += 1
if fvgSignal
    alignedFvgCount += 1
    float entry = candidateMid
    float stop = direction == 1 ? math.min(low, low[1]) - atr * slBufferAtr : math.max(high, high[1]) + atr * slBufferAtr
    float stopDistance = direction == 1 ? entry - stop : stop - entry
    float riskUsd = strategy.equity * riskPercent / 100.0
    float riskLots = stopDistance > 0 ? riskUsd / (stopDistance * contractSize) : na
    float baseLots = sizingMode == "Fixed lots" ? fixedLots : riskLots
    float scaledLots = not na(baseLots) ? baseLots * lotMultiplier : na
    float cappedLots = not na(scaledLots) ? math.min(scaledLots, maxLots) : na
    float lots = not na(cappedLots) ? f_roundDown(cappedLots, lotStep) : na
    bool riskOk = stopDistance >= atr * minStopAtr and stopDistance <= atr * maxStopAtr and not na(lots) and lots >= minLot
    if riskOk
        orderCount += 1
        plannedEntry := entry
        plannedSL := stop
        plannedTP := entry + direction * stopDistance * rewardRisk
        plannedLots := lots
        plannedQty := lots * contractSize
        beConfirmLevel := impulseExtreme
        fvgBar := bar_index
        stage := 2
        string entryId = direction == 1 ? "NY-CHOCH-L" : "NY-CHOCH-S"
        strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, qty = plannedQty, limit = plannedEntry)
        strategy.exit("NY-CHOCH-EXIT", from_entry = entryId, stop = plannedSL, limit = plannedTP)
    else
        riskRejectCount += 1

bool fvgWindowExpired = stage == 1 and bar_index - chochBar > maxChochToFvg
if stage == 1 and (fvgWindowExpired or not newPlanWindowOpen or newsBlackout)
    stage := 0

bool pendingExpired = stage == 2 and bar_index - fvgBar > pendingExpiry
bool targetBeforeEntry = stage == 2 and bar_index > fvgBar and (direction == 1 ? high >= plannedTP and low > plannedEntry : low <= plannedTP and high < plannedEntry)
if stage == 2 and (pendingExpired or not inNySession or newsBlackout or targetBeforeEntry or tradesToday >= maxTradesPerDay)
    strategy.cancel("NY-CHOCH-L")
    strategy.cancel("NY-CHOCH-S")
    stage := inNySession and bar_index - chochBar <= maxChochToFvg ? 1 : 0
    fvgBar := na
    plannedEntry := na
    plannedSL := na
    plannedTP := na
    plannedLots := na
    plannedQty := na
    beMoved := false

if stage == 2 and strategy.position_size != 0
    stage := 3
    positionWasOpen := true
    tradesToday += 1
if stage == 3 and strategy.position_size != 0
    bool structureConfirmed = direction == 1 ? close > beConfirmLevel : close < beConfirmLevel
    bool beNow = not beMoved and structureConfirmed and barstate.isconfirmed
    if beNow
        beMoved := true
        float beStop = direction == 1 ? strategy.position_avg_price + beOffset : strategy.position_avg_price - beOffset
        string activeEntryId = direction == 1 ? "NY-CHOCH-L" : "NY-CHOCH-S"
        strategy.exit("NY-CHOCH-EXIT", from_entry = activeEntryId, stop = beStop, limit = plannedTP)
if stage == 3 and strategy.position_size == 0 and positionWasOpen
    positionWasOpen := false
    stage := inNySession and tradesToday < maxTradesPerDay and bar_index - chochBar <= maxChochToFvg ? 1 : 0
    fvgBar := na
    plannedEntry := na
    plannedSL := na
    plannedTP := na
    plannedLots := na
    plannedQty := na
    beMoved := false

plot(stage >= 2 ? plannedEntry : na, "Entry", color.white, 2, plot.style_linebr)
plot(stage >= 2 ? plannedSL : na, "Stop", color.red, 2, plot.style_linebr)
plot(stage >= 2 ? plannedTP : na, "Take profit", color.lime, 2, plot.style_linebr)
plotshape(bullChoch, "Bullish CHoCH", shape.triangleup, location.belowbar, color = color.teal, size = size.tiny)
plotshape(bearChoch, "Bearish CHoCH", shape.triangledown, location.abovebar, color = color.orange, size = size.tiny)
plotshape(fvgSignal, "Golden-zone FVG", shape.diamond, location.abovebar, color = color.yellow, size = size.tiny)
bgcolor(inNySession ? color.new(color.blue, 94) : na, title = "NY Open")

var table diagnostics = table.new(position.bottom_right, 2, 7, bgcolor = color.new(color.black, 15), frame_color = color.gray, frame_width = 1)
if barstate.islast
    table.clear(diagnostics, 0, 0, 1, 6)
    if showDiagnostics
        table.cell(diagnostics, 0, 0, "NY SMC TEST", text_color = color.white, bgcolor = color.new(color.blue, 40))
        table.cell(diagnostics, 1, 0, signalProfile, text_color = balancedProfile ? color.orange : color.lime, bgcolor = color.new(color.blue, 40))
        table.cell(diagnostics, 0, 1, "Raw / qualified CHoCH", text_color = color.white)
        table.cell(diagnostics, 1, 1, str.tostring(rawChochCount) + " / " + str.tostring(qualifiedChochCount), text_color = color.aqua)
        table.cell(diagnostics, 0, 2, "FVG / golden aligned", text_color = color.white)
        table.cell(diagnostics, 1, 2, str.tostring(fvgCount) + " / " + str.tostring(alignedFvgCount), text_color = color.aqua)
        table.cell(diagnostics, 0, 3, "Orders / rejects", text_color = color.white)
        table.cell(diagnostics, 1, 3, str.tostring(orderCount) + " / " + str.tostring(riskRejectCount), text_color = orderCount > 0 ? color.lime : color.red)
        table.cell(diagnostics, 0, 4, "Closed / open", text_color = color.white)
        table.cell(diagnostics, 1, 4, str.tostring(strategy.closedtrades) + " / " + str.tostring(strategy.opentrades), text_color = color.yellow)
        table.cell(diagnostics, 0, 5, "Stage / planned lots", text_color = color.white)
        table.cell(diagnostics, 1, 5, str.tostring(stage) + " / " + (na(plannedLots) ? "-" : str.tostring(plannedLots)), text_color = color.white)
        table.cell(diagnostics, 0, 6, "Platform / date", text_color = color.white)
        table.cell(diagnostics, 1, 6, (platformOk ? "OK" : "BLOCK") + " / " + (dateOk ? "OK" : "BLOCK"), text_color = platformOk and dateOk ? color.lime : color.red)
