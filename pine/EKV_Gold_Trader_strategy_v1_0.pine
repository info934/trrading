//@version=6
// @description NY SMC research strategy for TradingView Strategy Tester only.
// It is a conservative model of confirmed-bar signals, not an MT5 fill simulator.
strategy("EKV Gold Trader Strategy v1.0 — NY SMC Backtest", overlay = true, pyramiding = 0, initial_capital = 100000, currency = currency.USD, commission_type = strategy.commission.percent, commission_value = 0.01, slippage = 2, margin_long = 1, margin_short = 1, process_orders_on_close = false, calc_on_order_fills = false, max_labels_count = 100, max_lines_count = 100)

const string G_TEST = "01 — Test environment"
const string G_BIAS = "02 — HTF bias"
const string G_SETUP = "03 — NY SMC setup"
const string G_RISK = "04 — Risk model"
const string G_NEWS = "05 — Manual news blackout"

bool enforceM5 = input.bool(true, "Allow entries only on M5", group = G_TEST)
bool enforceXauUsd = input.bool(true, "Allow entries only on XAUUSD", group = G_TEST)
bool showDiagnostics = input.bool(false, "Show backtest diagnostics", group = G_TEST, tooltip = "Enable only while debugging the setup funnel.")
int testFrom = input.time(timestamp("01 Jan 2023 00:00 +0000"), "Test from", group = G_TEST)
int testTo = input.time(timestamp("01 Jan 2030 00:00 +0000"), "Test to", group = G_TEST)
int maxTradesPerDay = input.int(2, "Maximum filled trades per NY day", minval = 1, maxval = 5, group = G_TEST)
string nyTimezone = input.string("America/New_York", "Session timezone", group = G_TEST)
string nySession = input.session("0930-1200", "NY Open entry window", group = G_TEST)

string h1Tf = input.timeframe("60", "H1 timeframe", group = G_BIAS)
string h4Tf = input.timeframe("240", "H4 timeframe", group = G_BIAS)
int fastLen = input.int(50, "Fast EMA", minval = 2, group = G_BIAS)
int slowLen = input.int(200, "Slow EMA", minval = 10, group = G_BIAS)
bool useSlope = input.bool(true, "Require fast EMA slope", group = G_BIAS)
string signalProfile = input.string("Balanced experimental", "Backtest profile", options = ["Production", "Balanced experimental"], group = G_BIAS, tooltip = "Production requires H1 and H4 alignment. Balanced allows one directional HTF bias only when the other HTF is not opposite.")

int swingLen = input.int(3, "Confirmed pivot length", minval = 2, maxval = 15, group = G_SETUP)
int maxSweepToChoch = input.int(12, "Max bars: sweep → CHoCH", minval = 2, maxval = 50, group = G_SETUP)
int maxChochToFvg = input.int(8, "Max bars: CHoCH → FVG", minval = 1, maxval = 30, group = G_SETUP)
int pendingExpiry = input.int(20, "FVG limit expiry (bars)", minval = 1, maxval = 50, group = G_SETUP)
int atrLen = input.int(14, "ATR length", minval = 2, group = G_SETUP)
float maxSweepDepthAtr = input.float(1.0, "Maximum sweep depth (ATR)", minval = 0.1, step = 0.05, group = G_SETUP)
float displacementAtr = input.float(0.3, "Minimum CHoCH body (ATR)", minval = 0.0, step = 0.05, group = G_SETUP)
float minFvgAtr = input.float(0.05, "Minimum FVG size (ATR)", minval = 0.0, step = 0.01, group = G_SETUP)
string entryMode = input.string("Proximal edge", "FVG limit entry", options = ["Midpoint", "Proximal edge"], group = G_SETUP)
string executionMode = input.string("Market on FVG (experimental)", "Backtest execution", options = ["Limit retracement", "Market on FVG (experimental)"], group = G_SETUP, tooltip = "Market mode increases the research sample but is not equivalent to the production limit-retracement workflow.")
float slBufferAtr = input.float(0.1, "SL buffer behind sweep (ATR)", minval = 0.0, step = 0.05, group = G_SETUP)
float minStopAtr = input.float(0.1, "Minimum stop distance (ATR)", minval = 0.1, step = 0.05, group = G_SETUP, tooltip = "Wide research default. Tighten this range only after reviewing the risk-reject counter.")
float maxStopAtr = input.float(10.0, "Maximum stop distance (ATR)", minval = 0.5, step = 0.1, group = G_SETUP, tooltip = "Wide research default. Tighten this range only after reviewing the risk-reject counter.")

float riskPercent = input.float(0.5, "Risk per trade (% equity)", minval = 0.05, maxval = 2.0, step = 0.05, group = G_RISK)
float rewardRisk = input.float(3.0, "Take profit (R)", minval = 1.0, maxval = 10.0, step = 0.25, group = G_RISK)
float breakEvenAtR = input.float(1.5, "Move SL to BE after close (R)", minval = 0.5, maxval = 5.0, step = 0.25, group = G_RISK)
float beOffset = input.float(0.1, "BE cost offset (USD/oz)", minval = 0.0, step = 0.01, group = G_RISK)
float contractSize = input.float(100.0, "Contract size: oz per lot", minval = 1.0, group = G_RISK)
float minLot = input.float(0.01, "Minimum lot", minval = 0.001, step = 0.001, group = G_RISK)
float lotStep = input.float(0.01, "Lot step", minval = 0.001, step = 0.001, group = G_RISK)

bool useNews = input.bool(false, "Enable manual news blackout", group = G_NEWS)
int newsBeforeMin = input.int(30, "Minutes blocked before event", minval = 0, maxval = 180, group = G_NEWS)
int newsAfterMin = input.int(30, "Minutes blocked after event", minval = 0, maxval = 180, group = G_NEWS)
bool news1On = input.bool(false, "Use event 1", inline = "N1", group = G_NEWS)
int news1 = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Event 1", inline = "N1", group = G_NEWS)
bool news2On = input.bool(false, "Use event 2", inline = "N2", group = G_NEWS)
int news2 = input.time(timestamp("01 Jan 2026 00:00 +0000"), "Event 2", inline = "N2", group = G_NEWS)

f_roundDown(float value, float step) =>
    step > 0 ? math.floor(value / step + 1e-9) * step : value

f_inNews(bool enabled, int eventTime, int beforeMs, int afterMs) =>
    enabled and time_close >= eventTime - beforeMs and time <= eventTime + afterMs

float h1Close = request.security(syminfo.tickerid, h1Tf, close[1], lookahead = barmerge.lookahead_on)
float h1Fast = request.security(syminfo.tickerid, h1Tf, ta.ema(close, fastLen)[1], lookahead = barmerge.lookahead_on)
float h1FastPrev = request.security(syminfo.tickerid, h1Tf, ta.ema(close, fastLen)[2], lookahead = barmerge.lookahead_on)
float h1Slow = request.security(syminfo.tickerid, h1Tf, ta.ema(close, slowLen)[1], lookahead = barmerge.lookahead_on)
float h4Close = request.security(syminfo.tickerid, h4Tf, close[1], lookahead = barmerge.lookahead_on)
float h4Fast = request.security(syminfo.tickerid, h4Tf, ta.ema(close, fastLen)[1], lookahead = barmerge.lookahead_on)
float h4FastPrev = request.security(syminfo.tickerid, h4Tf, ta.ema(close, fastLen)[2], lookahead = barmerge.lookahead_on)
float h4Slow = request.security(syminfo.tickerid, h4Tf, ta.ema(close, slowLen)[1], lookahead = barmerge.lookahead_on)
bool h1Bull = h1Close > h1Slow and h1Fast > h1Slow and (not useSlope or h1Fast > h1FastPrev)
bool h1Bear = h1Close < h1Slow and h1Fast < h1Slow and (not useSlope or h1Fast < h1FastPrev)
bool h4Bull = h4Close > h4Slow and h4Fast > h4Slow and (not useSlope or h4Fast > h4FastPrev)
bool h4Bear = h4Close < h4Slow and h4Fast < h4Slow and (not useSlope or h4Fast < h4FastPrev)
bool biasBull = h1Bull and h4Bull
bool biasBear = h1Bear and h4Bear
bool productionProfile = signalProfile == "Production"
bool balancedProfile = signalProfile == "Balanced experimental"
bool biasGateBull = productionProfile ? biasBull : (h1Bull or h4Bull) and not (h1Bear or h4Bear)
bool biasGateBear = productionProfile ? biasBear : (h1Bear or h4Bear) and not (h1Bull or h4Bull)

float atr = ta.atr(atrLen)
bool timeframeOk = timeframe.isminutes and timeframe.multiplier == 5
bool symbolOk = str.contains(syminfo.ticker, "XAUUSD")
bool htfOk = timeframe.in_seconds(h1Tf) > timeframe.in_seconds() and timeframe.in_seconds(h4Tf) > timeframe.in_seconds(h1Tf)
bool configOk = fastLen < slowLen and minStopAtr <= maxStopAtr and minLot > 0 and lotStep > 0
bool platformOk = (not enforceM5 or timeframeOk) and (not enforceXauUsd or symbolOk) and htfOk and configOk
int endHour = int(str.tonumber(str.substring(nySession, 5, 7)))
int endMinute = int(str.tonumber(str.substring(nySession, 7, 9)))
int endMinuteOfDay = endHour * 60 + endMinute
int closeMinuteOfDay = hour(time_close, nyTimezone) * 60 + minute(time_close, nyTimezone)
bool inNySession = not na(time(timeframe.period, nySession, nyTimezone))
bool newPlanWindowOpen = inNySession and closeMinuteOfDay < endMinuteOfDay
int beforeMs = newsBeforeMin * 60000
int afterMs = newsAfterMin * 60000
bool newsBlackout = useNews and (f_inNews(news1On, news1, beforeMs, afterMs) or f_inNews(news2On, news2, beforeMs, afterMs))
bool dateOk = time >= testFrom and time <= testTo

int nyDayKey = year(time, nyTimezone) * 10000 + month(time, nyTimezone) * 100 + dayofmonth(time, nyTimezone)
var int lastNyDayKey = na
var int tradesToday = 0
if na(lastNyDayKey) or nyDayKey != lastNyDayKey
    lastNyDayKey := nyDayKey
    tradesToday := 0

float pivotHigh = ta.pivothigh(high, swingLen, swingLen)
float pivotLow = ta.pivotlow(low, swingLen, swingLen)
var float lastSwingHigh = na
var float lastSwingLow = na
var int lastSwingHighBar = na
var int lastSwingLowBar = na
if not na(pivotHigh)
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - swingLen
if not na(pivotLow)
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - swingLen

var int stage = 0
var int direction = 0
var int sweepBar = na
var int chochBar = na
var int fvgBar = na
var float sweepExtreme = na
var float sweepReference = na
var float chochLevel = na
var float plannedEntry = na
var float plannedSL = na
var float plannedTP = na
var float plannedRisk = na
var float plannedQty = na
var bool beMoved = false
var bool positionWasOpen = false
var int rawSweepCount = 0
var int qualifiedSweepCount = 0
var int chochCount = 0
var int fvgCount = 0
var int riskRejectCount = 0
var int orderCount = 0

bool canStart = stage == 0 and strategy.position_size == 0 and platformOk and dateOk and newPlanWindowOpen and not newsBlackout and tradesToday < maxTradesPerDay
float bullSweepDepth = not na(lastSwingLow) ? lastSwingLow - low : na
float bearSweepDepth = not na(lastSwingHigh) ? high - lastSwingHigh : na
bool rawBullSweep = not na(lastSwingLow) and low < lastSwingLow and close > lastSwingLow and bullSweepDepth <= atr * maxSweepDepthAtr and bar_index > lastSwingLowBar and barstate.isconfirmed
bool rawBearSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh and bearSweepDepth <= atr * maxSweepDepthAtr and bar_index > lastSwingHighBar and barstate.isconfirmed
bool bullSweep = canStart and biasGateBull and rawBullSweep and not rawBearSweep
bool bearSweep = canStart and biasGateBear and rawBearSweep and not rawBullSweep
if rawBullSweep or rawBearSweep
    rawSweepCount += 1
if bullSweep or bearSweep
    qualifiedSweepCount += 1
if bullSweep
    stage := 1
    direction := 1
    sweepBar := bar_index
    sweepExtreme := low
    sweepReference := lastSwingLow
    chochLevel := lastSwingHigh
if bearSweep
    stage := 1
    direction := -1
    sweepBar := bar_index
    sweepExtreme := high
    sweepReference := lastSwingHigh
    chochLevel := lastSwingLow

if stage == 1 and direction == 1
    sweepExtreme := math.min(sweepExtreme, low)
if stage == 1 and direction == -1
    sweepExtreme := math.max(sweepExtreme, high)
bool sweepExpired = stage == 1 and bar_index - sweepBar > maxSweepToChoch
bool sweepDepthInvalid = stage == 1 and (direction == 1 ? sweepReference - sweepExtreme > atr * maxSweepDepthAtr : sweepExtreme - sweepReference > atr * maxSweepDepthAtr)
bool sweepCloseInvalid = stage == 1 and (direction == 1 ? close < sweepReference : close > sweepReference)
if stage == 1 and (sweepExpired or sweepDepthInvalid or sweepCloseInvalid or not inNySession or newsBlackout)
    stage := 0
    direction := 0
    sweepBar := na
    sweepExtreme := na
    sweepReference := na
    chochLevel := na

float body = math.abs(close - open)
bool displacementOk = displacementAtr <= 0 or body >= atr * displacementAtr
bool bullChoch = stage == 1 and direction == 1 and bar_index > sweepBar and close > chochLevel and displacementOk and barstate.isconfirmed
bool bearChoch = stage == 1 and direction == -1 and bar_index > sweepBar and close < chochLevel and displacementOk and barstate.isconfirmed
if bullChoch or bearChoch
    stage := 2
    chochBar := bar_index
    chochCount += 1

bool fvgExpired = stage == 2 and bar_index - chochBar > maxChochToFvg
if stage == 2 and (fvgExpired or not newPlanWindowOpen or newsBlackout)
    stage := 0
    direction := 0
    sweepBar := na
    chochBar := na
    sweepExtreme := na
    sweepReference := na
    chochLevel := na
bool bullFvg = stage == 2 and direction == 1 and bar_index > chochBar and newPlanWindowOpen and low > high[2] and low - high[2] >= atr * minFvgAtr and barstate.isconfirmed
bool bearFvg = stage == 2 and direction == -1 and bar_index > chochBar and newPlanWindowOpen and high < low[2] and low[2] - high >= atr * minFvgAtr and barstate.isconfirmed
if bullFvg or bearFvg
    fvgCount += 1
    float fvgLow = bullFvg ? high[2] : high
    float fvgHigh = bullFvg ? low : low[2]
    float proximal = direction == 1 ? fvgHigh : fvgLow
    bool marketOnFvg = executionMode == "Market on FVG (experimental)"
    float limitEntry = entryMode == "Midpoint" ? (fvgLow + fvgHigh) / 2.0 : proximal
    float entry = marketOnFvg ? close : limitEntry
    float stop = direction == 1 ? sweepExtreme - atr * slBufferAtr : sweepExtreme + atr * slBufferAtr
    float stopDistance = direction == 1 ? entry - stop : stop - entry
    float riskUsd = strategy.equity * riskPercent / 100.0
    float rawLots = stopDistance > 0 ? riskUsd / (stopDistance * contractSize) : na
    float lots = not na(rawLots) ? f_roundDown(rawLots, lotStep) : na
    bool riskOk = stopDistance >= atr * minStopAtr and stopDistance <= atr * maxStopAtr and not na(lots) and lots >= minLot and beOffset < stopDistance * breakEvenAtR
    if riskOk
        orderCount += 1
        plannedEntry := entry
        plannedSL := stop
        plannedTP := entry + direction * stopDistance * rewardRisk
        plannedRisk := stopDistance
        plannedQty := lots * contractSize
        fvgBar := bar_index
        stage := 3
        string entryId = direction == 1 ? "NY-SMC-L" : "NY-SMC-S"
        if marketOnFvg
            strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, qty = plannedQty)
        else
            strategy.entry(entryId, direction == 1 ? strategy.long : strategy.short, qty = plannedQty, limit = plannedEntry)
        strategy.exit("NY-SMC-EXIT", from_entry = entryId, stop = plannedSL, limit = plannedTP)
    else
        riskRejectCount += 1
        stage := 0
        direction := 0
        sweepBar := na
        chochBar := na
        sweepExtreme := na
        sweepReference := na
        chochLevel := na

bool pendingExpired = stage == 3 and bar_index - fvgBar > pendingExpiry
bool targetBeforeEntry = stage == 3 and bar_index > fvgBar and (direction == 1 ? high >= plannedTP and low > plannedEntry : low <= plannedTP and high < plannedEntry)
if stage == 3 and (pendingExpired or not inNySession or newsBlackout or targetBeforeEntry or tradesToday >= maxTradesPerDay)
    strategy.cancel("NY-SMC-L")
    strategy.cancel("NY-SMC-S")
    stage := 0
    direction := 0
    sweepBar := na
    chochBar := na
    fvgBar := na
    sweepExtreme := na
    sweepReference := na
    chochLevel := na
    plannedEntry := na
    plannedSL := na
    plannedTP := na
    plannedRisk := na
    plannedQty := na
    beMoved := false

if stage == 3 and strategy.position_size != 0
    stage := 4
    positionWasOpen := true
    tradesToday += 1
if stage == 4 and strategy.position_size != 0
    float beTrigger = strategy.position_avg_price + direction * plannedRisk * breakEvenAtR
    bool beNow = not beMoved and (direction == 1 ? close >= beTrigger : close <= beTrigger) and barstate.isconfirmed
    if beNow
        beMoved := true
        float beStop = direction == 1 ? strategy.position_avg_price + beOffset : strategy.position_avg_price - beOffset
        string activeEntryId = direction == 1 ? "NY-SMC-L" : "NY-SMC-S"
        strategy.exit("NY-SMC-EXIT", from_entry = activeEntryId, stop = beStop, limit = plannedTP)
if stage == 4 and strategy.position_size == 0 and positionWasOpen
    positionWasOpen := false
    stage := 0
    direction := 0
    sweepBar := na
    chochBar := na
    fvgBar := na
    sweepExtreme := na
    sweepReference := na
    chochLevel := na
    plannedEntry := na
    plannedSL := na
    plannedTP := na
    plannedRisk := na
    plannedQty := na
    beMoved := false

plot(stage >= 3 ? plannedEntry : na, "Entry", color.white, 2, plot.style_linebr)
plot(stage >= 3 ? plannedSL : na, "Stop", color.red, 2, plot.style_linebr)
plot(stage >= 3 ? plannedTP : na, "Take profit", color.lime, 2, plot.style_linebr)
plotshape(bullSweep, "Bullish sweep", shape.triangleup, location.belowbar, color = color.teal, size = size.tiny)
plotshape(bearSweep, "Bearish sweep", shape.triangledown, location.abovebar, color = color.orange, size = size.tiny)
plotshape(bullChoch or bearChoch, "CHoCH", shape.circle, location.abovebar, color = color.yellow, size = size.tiny)
bgcolor(inNySession ? color.new(color.blue, 94) : na, title = "NY Open")

var table diagnostics = table.new(position.bottom_right, 2, 7, bgcolor = color.new(color.black, 15), frame_color = color.gray, frame_width = 1)
if barstate.islast
    table.clear(diagnostics, 0, 0, 1, 6)
    if showDiagnostics
        table.cell(diagnostics, 0, 0, "NY SMC TEST", text_color = color.white, bgcolor = color.new(color.blue, 40))
        table.cell(diagnostics, 1, 0, signalProfile, text_color = balancedProfile ? color.orange : color.lime, bgcolor = color.new(color.blue, 40))
        table.cell(diagnostics, 0, 1, "Raw / qualified", text_color = color.white)
        table.cell(diagnostics, 1, 1, str.tostring(rawSweepCount) + " / " + str.tostring(qualifiedSweepCount), text_color = color.aqua)
        table.cell(diagnostics, 0, 2, "CHoCH / FVG", text_color = color.white)
        table.cell(diagnostics, 1, 2, str.tostring(chochCount) + " / " + str.tostring(fvgCount), text_color = color.aqua)
        table.cell(diagnostics, 0, 3, "Orders / rejects", text_color = color.white)
        table.cell(diagnostics, 1, 3, str.tostring(orderCount) + " / " + str.tostring(riskRejectCount), text_color = orderCount > 0 ? color.lime : color.red)
        table.cell(diagnostics, 0, 4, "Closed / open", text_color = color.white)
        table.cell(diagnostics, 1, 4, str.tostring(strategy.closedtrades) + " / " + str.tostring(strategy.opentrades), text_color = color.yellow)
        table.cell(diagnostics, 0, 5, "Stage / position", text_color = color.white)
        table.cell(diagnostics, 1, 5, str.tostring(stage) + " / " + str.tostring(strategy.position_size), text_color = color.white)
        table.cell(diagnostics, 0, 6, "Platform / date", text_color = color.white)
        table.cell(diagnostics, 1, 6, (platformOk ? "OK" : "BLOCK") + " / " + (dateOk ? "OK" : "BLOCK"), text_color = platformOk and dateOk ? color.lime : color.red)
